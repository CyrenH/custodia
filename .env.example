# ── Database ──────────────────────────────
POSTGRES_DB=custodia
POSTGRES_USER=custodia
POSTGRES_PASSWORD=changeme

# Values should match the Postgres ones above.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/custodia
SPRING_DATASOURCE_USERNAME=custodia
SPRING_DATASOURCE_PASSWORD=changeme

# ── JWT ───────────────────────────────────
# Must be a long, random, high-entropy string — used to sign/verify tokens.
# Generate with: openssl rand -base64 64
JWT_SECRET=changeme
JWT_EXPIRATION_MS=3600000

# ── Spring ────────────────────────────────
SPRING_PROFILES_ACTIVE=local